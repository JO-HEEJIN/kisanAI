# Server-side NASA Earthdata credentials for api/ routes and server/nasa-proxy.js.
# Nothing loads this file automatically: set these in the shell or in the
# Vercel project environment. Never commit real values.
NASA_USERNAME=
NASA_PASSWORD=
NASA_TOKEN=

# Server-side Google Gemini settings for server/vision.js (Railway environment).
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.8-flash.
GEMINI_VISION_MODEL=
